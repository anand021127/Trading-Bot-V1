# =============================================================================
# Trading-Bot-V1 — local development defaults (Windows / VS Code)
# Copy to .env and fill secrets. NEVER commit .env.
# =============================================================================

# --- Paper mode (REQUIRED default — do not enable live unless intentional) ---
TRADING_MODE=paper
TRADING_STRATEGY=V8_D_PULLBACK_ATM
UPSTOX_ORDER_PRODUCT=I

# --- Capital & risk ---
TRADING_CAPITAL=100000
RISK_PER_TRADE_PCT=0.025
MAX_ALLOCATION_PCT=0.18
CASH_BUFFER_PCT=0.40
MAX_DAILY_LOSS_PCT=0.02
MAX_TRADES_PER_DAY=3
MAX_CONCURRENT_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3
PAUSE_AFTER_LOSSES_MINUTES=30
EOD_SQUARE_OFF=15:15
DATABASE_PATH=data/trading_bot.db

# --- Upstox API (leave token empty for offline tests) ---
# Obtain from https://account.upstox.com / developer app.
# Required for live market data, option chain, and historical backtests.
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_WEBSOCKET_URL=wss://api.upstox.com/v3/feed/market-data-feed

# --- Frontend (Vite) ---
VITE_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Optional notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SECRET_KEY=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- AI layers (disabled / shadow by default) ---
AI_ENABLED=false
AI_MODE=shadow
AI_MIN_CONFIDENCE=0.70
AI_MIN_TRADE_PROBABILITY=0.65
AI_FAIL_OPEN=true
AI_MODELS_DIR=models/ai
COPILOT_ENABLED=false
COPILOT_MODE=shadow
COPILOT_MIN_RISK_REWARD=1.5
COPILOT_MAX_QUOTE_AGE_SECONDS=30
COPILOT_MAX_CANDLE_AGE_SECONDS=120
COPILOT_GAP_THRESHOLD_PCT=0.3
COPILOT_LLM_BACKEND=none
COPILOT_LLM_BASE_URL=http://localhost:11434/v1
COPILOT_LLM_MODEL=llama3.1:8b
COPILOT_LLM_TIMEOUT_SECONDS=8

# --- Backtest defaults ---
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_COMMISSION_PCT=0.0003
BACKTEST_SLIPPAGE_PCT=0.0001
BACKTEST_STT_PCT=0.001
BACKTEST_MIN_COVERAGE_PCT=80

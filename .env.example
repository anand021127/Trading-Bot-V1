EMAIL_PASSWORD=
FRONTEND_URL=
SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_WEBSOCKET_URL=wss://api.upstox.com/v3/feed/market-data-feed
VITE_BACKEND_URL=

# Paper mode (required — no silent OPTION_PREMIUM fallback)
TRADING_MODE=paper
TRADING_STRATEGY=V8_D_PULLBACK_ATM
UPSTOX_ORDER_PRODUCT=I
TRADING_CAPITAL=100000
RISK_PER_TRADE_PCT=0.025
MAX_ALLOCATION_PCT=0.18
CASH_BUFFER_PCT=0.40
MAX_DAILY_LOSS_PCT=0.02
MAX_TRADES_PER_DAY=3
MAX_CONCURRENT_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3
PAUSE_AFTER_LOSSES_MINUTES=30
DATABASE_PATH=data/trading_bot.db
EOD_SQUARE_OFF=15:15

# ── AI decision-filter layer (backend/ai/) ──────────────────────────────
# Disabled and shadow-only by default — see docs/AI_LAYER.md. Setting
# AI_ENABLED=true alone does NOT allow it to touch live orders; AI_MODE
# must also be explicitly set to "paper" or "live".
AI_ENABLED=false
AI_MODE=shadow
AI_MIN_CONFIDENCE=0.70
AI_MIN_TRADE_PROBABILITY=0.65
AI_FAIL_OPEN=true
AI_MODELS_DIR=models/ai

# ── AI Trading Copilot (backend/copilot/) ───────────────────────────────
# Disabled and shadow-only by default. Distinct from the AI_* vars above
# (those gate the ML probability filter inside the strategy pipeline;
# these gate the conversational/decision-plan Copilot). See docs/COPILOT.md.
COPILOT_ENABLED=false
COPILOT_MODE=shadow
COPILOT_MIN_RISK_REWARD=1.5
COPILOT_MAX_QUOTE_AGE_SECONDS=30
COPILOT_MAX_CANDLE_AGE_SECONDS=120
COPILOT_GAP_THRESHOLD_PCT=0.3
# LLM backend: "none" (zero-cost rule-based explanations, default) or
# "local_openai_compatible" (point at a local Ollama/llama.cpp server —
# still zero API cost, runs on your own machine, no Anthropic/OpenAI key).
COPILOT_LLM_BACKEND=none
COPILOT_LLM_BASE_URL=http://localhost:11434/v1
COPILOT_LLM_MODEL=llama3.1:8b
COPILOT_LLM_TIMEOUT_SECONDS=8
# Comma-separated extra CORS origins (Vercel preview URLs, etc.)
CORS_ORIGINS=
# Public frontend origin(s) allowed to call the API
# FRONTEND_URL=https://trading-bot-v1-snowy.vercel.app

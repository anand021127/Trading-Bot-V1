# =============================================================================
# Trading-Bot-V1 — environment template (SAFE PAPER-MODE DEFAULTS)
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#
# SAFETY MODEL
# ------------
# TRADING_MODE=paper is the only supported mode of this deployment.
# The paper runtime refuses to start unless strategy and product are set
# explicitly (fail closed). Live START is refused by the API, the node bridge,
# and worker_manager. There is no live-order code path in paper mode: paper
# fills execute only inside PaperBroker, and the Upstox client additionally
# refuses order placement during offline/test operation.
#
# CONFIG PRECEDENCE (highest wins):
#   1. Real process environment (systemd Environment=, shell export)
#   2. .env at the repo root (loaded by the process environment loader)
#   3. Built-in defaults in backend/config/settings.py
# Do not define the same variable in more than one place.
# =============================================================================

# ── Mode (DO NOT SET TO live — see PRODUCTION_DEPLOYMENT.md) ─────────────────
TRADING_MODE=paper
# Paper mode runs exactly one strategy; anything else refuses to start.
TRADING_STRATEGY=V8_D_PULLBACK_ATM
# Upstox product code for orders: I = Intraday, D = Delivery (NRML). Required
# explicitly; the runtime refuses the broker default.
UPSTOX_ORDER_PRODUCT=I

# ── Capital & risk (single authoritative set — used by paper, live and
#    backtest; conflicts between these values refuse startup) ─────────────────
TRADING_CAPITAL=100000
RISK_PER_TRADE_PCT=0.025
MAX_ALLOCATION_PCT=0.18
CASH_BUFFER_PCT=0.40
MAX_DAILY_LOSS_PCT=0.02
MAX_TRADES_PER_DAY=3
MAX_CONCURRENT_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3
PAUSE_AFTER_LOSSES_MINUTES=30
# IST square-off time; all open paper positions are closed at/after this time.
EOD_SQUARE_OFF=15:15

# ── Worker tuning ────────────────────────────────────────────────────────────
# Seconds between paper-worker ticks; heartbeat staleness threshold ~20s.
PAPER_WORKER_INTERVAL_SEC=2
# Where the SQLite database lives (worker + API must point at the SAME file).
DATABASE_PATH=data/trading_bot.db

# ── Upstox API (leave token empty for offline tests / no-market-data mode) ──
# Obtain from https://account.upstox.com → Developer → My Apps.
# The token is persisted to SQLite + data/upstox_token.json after OAuth
# verification; it is NOT written back into .env files (never commit it).
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_WEBSOCKET_URL=wss://api.upstox.com/v3/feed/market-data-feed

# ── Frontend (Vite dev / API base for local runs) ────────────────────────────
VITE_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Production (Vercel) deployment also accepts:
# CORS_ORIGINS=https://trading-bot-v1.vercel.app

# ── Optional notifications (disabled unless credentials present) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENDER_EMAIL=
RECIPIENT_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SECRET_KEY=

# ── AI layer (disabled by default; shadow mode never blocks trades) ──────────
AI_ENABLED=false
AI_MODE=shadow
AI_FAIL_OPEN=true
COPILOT_ENABLED=false
COPILOT_MODE=shadow

# -- AI TRADING DECISION layer (PHASE 5.1) ------------------------------------
# When enabled, every V8-D BUY signal is evaluated by the local LLM BEFORE the
# hard risk/execution gates: V8-D signal + AI APPROVE + Risk PASS + Sizer PASS
# + Pipeline PASS are ALL required. Any AI failure (timeout, provider down,
# malformed JSON) fails CLOSED to NO TRADE - never a fallback to auto-BUY.
# The AI layer never receives broker credentials and never places orders.
AI_DECISION_ENABLED=false
AI_DECISION_PROVIDER=ollama
AI_DECISION_MODEL=llama3.2:1b
AI_DECISION_BASE_URL=http://localhost:11434/v1
AI_DECISION_TIMEOUT_SECONDS=20
AI_DECISION_TEMPERATURE=0
AI_DECISION_MAX_TOKENS=128

# ── Backtest defaults ────────────────────────────────────────────────────────
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_COMMISSION_PCT=0.0003
BACKTEST_SLIPPAGE_PCT=0.0001
BACKTEST_STT_PCT=0.001
# Below this weekday coverage the backtest is marked INVALID_DATA, not scored.
BACKTEST_MIN_COVERAGE_PCT=80

# ── Test/offline switches (LEAVE UNSET IN PRODUCTION) ────────────────────────
# TRADING_BOT_OFFLINE_TESTS=1  blocks ALL live Upstox HTTP (data AND orders).
# PAPER_ALLOW_TEST_SIGNAL=1    enables the dashboard test-signal injector.
# ALLOW_LIVE_UPSTOX=1          ONLY for explicit live-data test sessions.
